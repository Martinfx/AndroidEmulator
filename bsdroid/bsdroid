#!/bin/sh
#
# bsdroid - run full Android (BlissOS / Android-x86 with Google Play) on FreeBSD
# using the bhyve hypervisor.
#
# Every VM lives in $BSDROID_DIR/<name>/ and is described by vm.conf.
# The guests sit on a private bridge ($BSDROID_BRIDGE, $BSDROID_NET.0/24)
# served by dnsmasq, so each VM gets a fixed IP and is reachable with adb.

set -eu

: "${BSDROID_CONF:=/usr/local/etc/bsdroid.conf}"
[ -r "$BSDROID_CONF" ] && . "$BSDROID_CONF"

: "${BSDROID_DIR:=/usr/local/bsdroid}"
: "${BSDROID_ZFS:=}"                    # e.g. zroot/bsdroid; enables snapshots
: "${BSDROID_BRIDGE:=bridge77}"
: "${BSDROID_NET:=10.77.0}"             # host is .1, guests start at .10
: "${BSDROID_UEFI:=/usr/local/share/uefi-firmware/BHYVE_UEFI.fd}"
: "${BSDROID_UEFI_VARS:=/usr/local/share/uefi-firmware/BHYVE_UEFI_VARS.fd}"
: "${BSDROID_VNC_VIEWER:=vncviewer}"

PROG=${0##*/}

die()  { echo "$PROG: $*" >&2; exit 1; }
info() { echo "==> $*"; }

need_root() { [ "$(id -u)" -eq 0 ] || die "this command needs root (use doas/sudo)"; }

vm_dir() { echo "$BSDROID_DIR/$1"; }

vm_exists() { [ -f "$(vm_dir "$1")/vm.conf" ]; }

load_vm() {
	vm_exists "$1" || die "VM '$1' does not exist (see: $PROG list)"
	VM=$1
	VMDIR=$(vm_dir "$1")
	. "$VMDIR/vm.conf"
}

valid_name() {
	case $1 in
	''|*[!a-zA-Z0-9_-]*) die "invalid VM name '$1' (use letters, digits, - and _)" ;;
	esac
}

bhyve_pid() {
	pgrep -f "^bhyve: bsdroid-$1\$" 2>/dev/null || true
}

is_running() { [ -n "$(bhyve_pid "$1")" ]; }

# Convert sizes like 4G / 512M to megabytes for bhyve -m.
to_mb() {
	case $1 in
	*[Gg]) echo $(( ${1%?} * 1024 )) ;;
	*[Mm]) echo "${1%?}" ;;
	*[!0-9]*) die "bad size '$1'" ;;
	*) echo "$1" ;;
	esac
}

# ---------------------------------------------------------------- setup

cmd_setup() {
	need_root
	info "Loading kernel modules"
	for m in vmm if_bridge if_tuntap nmdm; do
		kldstat -q -m "$m" 2>/dev/null || kldload "$m" 2>/dev/null || true
	done
	kldstat -q -m vmm || die "cannot load vmm.ko - is VT-x/AMD-V enabled in BIOS?"
	sysctl net.link.tap.up_on_open=1 >/dev/null

	for m in vmm_load if_bridge_load if_tuntap_load nmdm_load; do
		sysrc -f /boot/loader.conf "$m=YES" >/dev/null
	done
	grep -q '^net.link.tap.up_on_open' /etc/sysctl.conf 2>/dev/null ||
		echo 'net.link.tap.up_on_open=1' >> /etc/sysctl.conf

	info "Installing packages"
	pkg install -y bhyve-firmware dnsmasq tigervnc-viewer android-tools

	setup_bridge
	mkdir -p "$BSDROID_DIR"
	if [ -n "$BSDROID_ZFS" ] && ! zfs list "$BSDROID_ZFS" >/dev/null 2>&1; then
		info "Creating ZFS dataset $BSDROID_ZFS"
		zfs create -o mountpoint="$BSDROID_DIR" "$BSDROID_ZFS"
	fi
	write_dnsmasq
	print_nat_help
	info "Done. Next: $PROG create <name>"
}

setup_bridge() {
	if ! ifconfig "$BSDROID_BRIDGE" >/dev/null 2>&1; then
		info "Creating $BSDROID_BRIDGE ($BSDROID_NET.1/24)"
		ifconfig "$BSDROID_BRIDGE" create
	fi
	ifconfig "$BSDROID_BRIDGE" inet "$BSDROID_NET.1/24" up
	sysctl net.inet.ip.forwarding=1 >/dev/null
	sysrc gateway_enable=YES >/dev/null
	sysrc "cloned_interfaces+=$BSDROID_BRIDGE" >/dev/null
	sysrc "ifconfig_$BSDROID_BRIDGE=inet $BSDROID_NET.1/24 up" >/dev/null
}

write_dnsmasq() {
	conf=/usr/local/etc/dnsmasq.d/bsdroid.conf
	mkdir -p /usr/local/etc/dnsmasq.d
	{
		echo "# generated by $PROG - do not edit"
		echo "interface=$BSDROID_BRIDGE"
		echo "bind-interfaces"
		echo "dhcp-range=$BSDROID_NET.10,$BSDROID_NET.250,12h"
		echo "dhcp-option=option:router,$BSDROID_NET.1"
		echo "dhcp-option=option:dns-server,$BSDROID_NET.1"
		for f in "$BSDROID_DIR"/*/vm.conf; do
			[ -f "$f" ] || continue
			( . "$f"; echo "dhcp-host=$MAC,$IP" )
		done
	} > "$conf"
	grep -q '^conf-dir=/usr/local/etc/dnsmasq.d' /usr/local/etc/dnsmasq.conf 2>/dev/null ||
		echo 'conf-dir=/usr/local/etc/dnsmasq.d/,*.conf' >> /usr/local/etc/dnsmasq.conf
	sysrc dnsmasq_enable=YES >/dev/null
	service dnsmasq restart >/dev/null 2>&1 || service dnsmasq start >/dev/null 2>&1 || true
}

print_nat_help() {
	ext=$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}')
	cat <<EOF

To give the Android VMs internet access (needed for Google Play), enable NAT
in /etc/pf.conf, for example:

    nat on ${ext:-<external-if>} from $BSDROID_NET.0/24 to any -> (${ext:-<external-if>})

then: sysrc pf_enable=YES && service pf restart
EOF
}

# --------------------------------------------------------------- create

next_ip() {
	n=10
	while grep -qs "^IP=$BSDROID_NET.$n\$" "$BSDROID_DIR"/*/vm.conf; do
		n=$((n + 1))
	done
	[ $n -le 250 ] || die "no free IP address left"
	echo "$BSDROID_NET.$n"
}

next_vnc() {
	p=5900
	while grep -qs "^VNC_PORT=$p\$" "$BSDROID_DIR"/*/vm.conf; do
		p=$((p + 1))
	done
	echo $p
}

random_mac() {
	# 58:9c:fc is the bhyve OUI
	od -An -N3 -tx1 /dev/urandom | awk '{printf "58:9c:fc:%s:%s:%s\n", $1, $2, $3}'
}

cmd_create() {
	need_root
	[ $# -ge 1 ] || die "usage: $PROG create <name> [-m mem] [-c cpus] [-d disk] [-r WxH]"
	name=$1; shift
	valid_name "$name"
	vm_exists "$name" && die "VM '$name' already exists"

	mem=4G cpus=4 disk=32G res=1280x720
	while getopts m:c:d:r: opt; do
		case $opt in
		m) mem=$OPTARG ;;
		c) cpus=$OPTARG ;;
		d) disk=$OPTARG ;;
		r) res=$OPTARG ;;
		*) die "unknown option" ;;
		esac
	done
	w=${res%x*} h=${res#*x}
	[ "$w" -le 1920 ] && [ "$h" -le 1200 ] || die "bhyve framebuffer supports at most 1920x1200"

	[ -r "$BSDROID_UEFI" ] || die "UEFI firmware not found: $BSDROID_UEFI (run: $PROG setup)"

	dir=$(vm_dir "$name")
	if [ -n "$BSDROID_ZFS" ]; then
		zfs create "$BSDROID_ZFS/$name"
	else
		mkdir -p "$dir"
	fi

	truncate -s "$disk" "$dir/disk.img"
	cp "$BSDROID_UEFI_VARS" "$dir/uefi-vars.fd"

	cat > "$dir/vm.conf" <<EOF
MEM=$(to_mb "$mem")
CPUS=$cpus
WIDTH=$w
HEIGHT=$h
MAC=$(random_mac)
IP=$(next_ip)
VNC_PORT=$(next_vnc)
SOUND=yes
EOF
	write_dnsmasq
	info "Created VM '$name' ($mem RAM, $cpus CPU, $disk disk, ${w}x$h)"
	info "Next: $PROG install $name /path/to/Bliss-*-gapps*.iso"
}

# ------------------------------------------------------------ run / stop

ensure_tap() {
	tapfile=$VMDIR/tap
	if [ -f "$tapfile" ] && ifconfig "$(cat "$tapfile")" >/dev/null 2>&1; then
		TAP=$(cat "$tapfile")
	else
		TAP=$(ifconfig tap create)
		ifconfig "$TAP" description "bsdroid-$VM"
		echo "$TAP" > "$tapfile"
	fi
	ifconfig "$BSDROID_BRIDGE" addm "$TAP" 2>/dev/null || true
	ifconfig "$TAP" up
}

# Builds the bhyve command line into "$@" of the caller via set --
bhyve_args() {
	iso=$1 wait=$2
	ahci="hd:$VMDIR/disk.img"
	[ -n "$iso" ] && ahci="cd:$iso,$ahci"
	fbuf="tcp=127.0.0.1:$VNC_PORT,w=$WIDTH,h=$HEIGHT"
	[ "$wait" = yes ] && fbuf="$fbuf,wait"

	ARGS="-A -H -P -u -c $CPUS -m ${MEM}M"
	ARGS="$ARGS -s 0,hostbridge -s 31,lpc"
	ARGS="$ARGS -s 2,virtio-net,$TAP,mac=$MAC"
	ARGS="$ARGS -s 3,ahci,$ahci"
	ARGS="$ARGS -s 29,fbuf,$fbuf -s 30,xhci,tablet"
	if [ "${SOUND:-no}" = yes ] && [ -c /dev/dsp ]; then
		ARGS="$ARGS -s 4,hda,play=/dev/dsp,rec=/dev/dsp"
	fi
	ARGS="$ARGS -l bootrom,$BSDROID_UEFI,$VMDIR/uefi-vars.fd"
	ARGS="$ARGS bsdroid-$VM"
}

# Internal: supervises one VM. bhyve exits 0 on guest reboot, so loop then.
cmd__run() {
	load_vm "$1"
	iso=${2:-}
	rm -f "$VMDIR/stopping"
	while :; do
		ensure_tap
		bhyve_args "$iso" no
		# shellcheck disable=SC2086
		rc=0; bhyve $ARGS || rc=$?
		bhyvectl --destroy --vm="bsdroid-$VM" >/dev/null 2>&1 || true
		[ -f "$VMDIR/stopping" ] && break
		[ $rc -eq 0 ] || break
		iso=""          # after the installer reboots, boot from disk
	done
	rm -f "$VMDIR/stopping"
	ifconfig "$TAP" destroy 2>/dev/null || true
	rm -f "$VMDIR/tap"
}

start_vm() {
	need_root
	load_vm "$1"
	is_running "$VM" && die "VM '$VM' is already running"
	[ -z "${2:-}" ] || [ -r "$2" ] || die "cannot read ISO '$2'"
	daemon -f -p "$VMDIR/supervisor.pid" -o "$VMDIR/bhyve.log" \
		"$(realpath "$0")" _run "$VM" ${2:+"$2"}
	sleep 1
	is_running "$VM" || { tail -n 20 "$VMDIR/bhyve.log" >&2; die "bhyve failed to start"; }
	info "VM '$VM' running - display: VNC 127.0.0.1:$VNC_PORT, adb: $IP:5555"
}

cmd_install() {
	[ $# -eq 2 ] || die "usage: $PROG install <name> <iso>"
	start_vm "$1" "$(realpath "$2")"
	cat <<EOF

Installer started. Opening the screen now ($PROG vnc $1).
In the boot menu choose "Installation", partition the disk (GPT, ext4) and
install GRUB/EFI. After the install the VM reboots from disk by itself.
If the screen stays black on boot, edit the boot entry (press 'e') and append:
    nomodeset HWACCEL=0
EOF
	cmd_vnc "$1" &
}

cmd_start() {
	[ $# -eq 1 ] || die "usage: $PROG start <name>"
	start_vm "$1"
}

cmd_stop() {
	need_root
	[ $# -ge 1 ] || die "usage: $PROG stop <name> [-f]"
	load_vm "$1"
	pid=$(bhyve_pid "$VM")
	[ -n "$pid" ] || die "VM '$VM' is not running"
	touch "$VMDIR/stopping"
	if [ "${2:-}" != -f ]; then
		info "Asking Android to power off"
		if ! { adb_connect >/dev/null 2>&1 &&
		       adb -s "$IP:5555" shell reboot -p >/dev/null 2>&1; }; then
			kill -TERM "$pid"
		fi
		i=0
		while is_running "$VM" && [ $i -lt 60 ]; do sleep 1; i=$((i + 1)); done
	fi
	if is_running "$VM"; then
		info "Forcing power off"
		bhyvectl --force-poweroff --vm="bsdroid-$VM" 2>/dev/null || kill -KILL "$pid"
	fi
	info "VM '$VM' stopped"
}

# -------------------------------------------------------- display / adb

cmd_vnc() {
	[ $# -eq 1 ] || die "usage: $PROG vnc <name>"
	load_vm "$1"
	exec "$BSDROID_VNC_VIEWER" "127.0.0.1::$VNC_PORT"
}

adb_connect() {
	command -v adb >/dev/null || die "adb not found (pkg install android-tools)"
	adb connect "$IP:5555" | grep -q 'connected' || return 1
}

cmd_adb() {
	[ $# -ge 1 ] || die "usage: $PROG adb <name> [adb args...]"
	load_vm "$1"; shift
	adb_connect || die "cannot reach $IP:5555 - is the VM booted and network up?"
	exec adb -s "$IP:5555" "$@"
}

cmd_apk() {
	[ $# -ge 2 ] || die "usage: $PROG apk <name> <file.apk>..."
	load_vm "$1"; shift
	adb_connect || die "cannot reach $IP:5555"
	for apk in "$@"; do
		info "Installing $apk"
		adb -s "$IP:5555" install -r "$apk"
	done
}

# Google Play refuses to sign in on uncertified devices until their GSF ID is
# registered at https://www.google.com/android/uncertified
cmd_gsf_id() {
	[ $# -eq 1 ] || die "usage: $PROG gsf-id <name>"
	load_vm "$1"
	adb_connect || die "cannot reach $IP:5555"
	adb -s "$IP:5555" root >/dev/null 2>&1 || true
	sleep 2
	adb_connect >/dev/null 2>&1 || true
	id=$(adb -s "$IP:5555" shell \
		"sqlite3 /data/data/com.google.android.gsf/databases/gservices.db \
		\"select value from main where name='android_id';\"" | tr -d '\r')
	[ -n "$id" ] || die "GSF ID not found - open Play Store once, then retry"
	echo "GSF Android ID: $id"
	echo "Register it at https://www.google.com/android/uncertified, wait a few minutes and reboot the VM."
}

# ---------------------------------------------------------- snapshots

need_zfs() {
	[ -n "$BSDROID_ZFS" ] || die "snapshots need BSDROID_ZFS set in $BSDROID_CONF"
}

cmd_snapshot() {
	need_root; need_zfs
	[ $# -eq 2 ] || die "usage: $PROG snapshot <name> <snapname>"
	load_vm "$1"
	is_running "$VM" && die "stop the VM first for a consistent snapshot"
	zfs snapshot "$BSDROID_ZFS/$VM@$2"
	info "Snapshot $VM@$2 created"
}

cmd_rollback() {
	need_root; need_zfs
	[ $# -eq 2 ] || die "usage: $PROG rollback <name> <snapname>"
	load_vm "$1"
	is_running "$VM" && die "stop the VM first"
	zfs rollback -r "$BSDROID_ZFS/$VM@$2"
	info "VM '$VM' rolled back to $2"
}

cmd_snapshots() {
	need_zfs
	[ $# -eq 1 ] || die "usage: $PROG snapshots <name>"
	zfs list -H -t snapshot -o name,creation -s creation -r "$BSDROID_ZFS/$1" |
		sed "s|^$BSDROID_ZFS/||"
}

# ------------------------------------------------------- list / destroy

cmd_list() {
	printf '%-16s %-8s %-15s %-6s %s\n' NAME STATE IP VNC RES
	for f in "$BSDROID_DIR"/*/vm.conf; do
		[ -f "$f" ] || continue
		n=$(basename "$(dirname "$f")")
		( . "$f"
		  st=stopped; is_running "$n" && st=running
		  printf '%-16s %-8s %-15s %-6s %s\n' "$n" "$st" "$IP" "$VNC_PORT" "${WIDTH}x$HEIGHT" )
	done
}

cmd_destroy() {
	need_root
	[ $# -eq 1 ] || die "usage: $PROG destroy <name>"
	load_vm "$1"
	is_running "$VM" && die "stop the VM first"
	printf "Really delete VM '%s' and its disk? [y/N] " "$VM"
	read -r ans
	[ "$ans" = y ] || [ "$ans" = Y ] || exit 1
	if [ -n "$BSDROID_ZFS" ]; then
		zfs destroy -r "$BSDROID_ZFS/$VM"
	fi
	rm -rf "$VMDIR"
	write_dnsmasq
	info "VM '$VM' destroyed"
}

usage() {
	cat <<EOF
usage: $PROG <command> [args]

  setup                         load modules, install packages, create network
  create <name> [-m 4G] [-c 4] [-d 32G] [-r 1280x720]
  install <name> <iso>          boot the BlissOS/Android-x86 installer
  start <name>                  boot the VM
  stop <name> [-f]              power off (-f: immediately)
  vnc <name>                    show the screen
  adb <name> [args...]          run adb against the VM (e.g. adb vm shell)
  apk <name> <file.apk>...      install APK files
  gsf-id <name>                 print the GSF ID for Google Play registration
  snapshot|rollback <name> <snap>   ZFS snapshots (VM must be stopped)
  snapshots <name>              list snapshots
  list                          list VMs
  destroy <name>                delete a VM
EOF
}

[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1; shift
case $cmd in
setup|create|install|start|stop|vnc|adb|apk|snapshot|rollback|snapshots|list|destroy|_run)
	"cmd_$cmd" "$@" ;;
gsf-id)	cmd_gsf_id "$@" ;;
help|-h|--help) usage ;;
*)	usage; exit 1 ;;
esac
